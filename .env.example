# ==============================================================================
# POSSD DOCUMENT TRACKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# PostgreSQL Database Configuration (Production / Local)
# Browser NEVER connects to PostgreSQL directly; only Node.js server connects.
DATABASE_URL=postgres://possd_user:your_password_here@localhost:5432/possd
PGHOST=localhost
PGPORT=5432
PGUSER=possd_user
PGPASSWORD=your_password_here
PGDATABASE=possd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=possd
DB_USER=possd_user
DB_PASSWORD=your_password_here

# Cloud SQL Unix Socket (Optional: Used when deployed on Google Cloud)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Google Apps Script Web App (Legacy Sync / Mirroring during Phase 0-1)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
API_SECRET=your_secure_random_string_here

# Firebase Client Configuration (Exposed to browser client via VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
