# ==============================================================================
# POSSD DOCUMENT TRACKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE REQUIREMENTS (Must be set in all environments)
# ------------------------------------------------------------------------------

# 1. Database Connection URL
# Standard PostgreSQL connection string. The server connects via this URL.
DATABASE_URL=postgres://possd_user:your_password_here@localhost:5432/possd

# 2. JWT Secret
# Secure secret key for signing session tokens.
# FATAL: Missing this variable in production will prevent application startup.
JWT_SECRET=your_secure_random_jwt_secret_here

# 3. Environment & Auth Mode
# For development: NODE_ENV=development and AUTH_MODE=development
# For production: NODE_ENV=production and AUTH_MODE=postgres
NODE_ENV=development
AUTH_MODE=development

# ------------------------------------------------------------------------------
# DEVELOPMENT ONLY REQUIREMENTS
# ------------------------------------------------------------------------------

# 1. Development Admin Password
# Password for the 'dev-admin@localhost.test' seed account in the local dev database.
DEV_ADMIN_PASSWORD=dev_admin_secret_123
